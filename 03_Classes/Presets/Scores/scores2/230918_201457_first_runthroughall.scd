[ '/code', "//:--[40] start the sound with named busses
//======= stop synths from previous tests. =======
nil +>.jun \\freq;
nil +>.jun \\amp;
nil +>.jun \\freqmod;
nil +>.jun \\freqmodnoise;
nil +>.asayo \\freq;
nil +>.asayo \\amp;
nil +>.asayo \\freqmod;
nil +>.asayo \\freqmodnoise;
//======= initialize busses =======
200 @>.jun \\freq;
800 @>.asayo \\freq;
0.1 @>.jun \\amp;
0.1 @>.asayo \\amp;
1 @>.jun \\vol;
1 @>.asayo \\vol;
{
	50.do({ | i | (\\freq +++ i).bus.set(1)});
	Silent.ar.perc;
} +>.jun \\fmod;
{
	50.do({ | i | (\\freq +++ i).bus.set(1)});
	Silent.ar.perc;
} +>.asayo \\fmod;
//======= add sensor control =======
{ \\x7.gt.lag(0.5) * 0.5 } @>.jun \\amp;
{ \\z8.gt(0.3).lag(0.5) * 0.5 } @>.asayo \\amp;

//======= Set sensor values to off =======
0 >>! \\x7;
0 >>! \\z8;
//======= Start sine synth =======
{
	var fmod;
	fmod = \\freq.br(200) * \\freq.brdup(50, 1);
	DynKlang.ar(
		`[
			fmod,
			0.8 / 50,
			pi
		]
	).amplify.vol.pan(0);
} +> \\jun;
{
	var fmod;
	fmod = \\freq.br(800) * \\freq.brdup(50, 1);
	DynKlang.ar(
		`[
			fmod,
			0.8 / 50,
			pi
		]
	).amplify.vol.pan(0);
} +> \\asayo;" ]
