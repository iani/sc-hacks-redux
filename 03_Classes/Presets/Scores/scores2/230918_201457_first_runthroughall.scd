[ '/code', "//:--[40] add softening cluster noise modulation
{ \\z5.sr.lag(0.5).lin(0, 0.01) } @>.jun \\noiseb;
{ \\y8.sr.lag(0.5).lin(0, 0.01) } @>.asayo \\noiseb;
1.1 @>.jun \\vol;
1.1 @>.asayo \\vol;

{
		50 do: { | i |
			LFNoise2.kr(1).range(
				1, 1 + \\noiseb.br(0.0001)).bout(\\freq +++ i)
		};
} +>.jun \\freqmodnoise;
{
		50 do: { | i |
			LFNoise2.kr(1).range(
				1, 1 + \\noiseb.br(0.0001)).bout(\\freq +++ i)
		};
} +>.asayo \\freqmodnoise;" ]
